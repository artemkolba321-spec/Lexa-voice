{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexa",
  "version": "0.1.0",
  "identifier": "dev.lexa.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lexa",
        "width": 480,
        "height": 860,
        "minWidth": 480,
        "minHeight": 860,
        "resizable": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#0b0d12",
        "maxWidth": 480,
        "maxHeight": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Utility",
    "shortDescription": "Локальный голосовой мульти-инструмент"
  }
}
